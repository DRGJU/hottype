---
import '../styles/tokens.css';
import '../styles/styles.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'HOTTYPE 热字印刷 —— 一台 AI 传单机。半句话进去，印刷感的传单、海报、小志出来。演示构建。',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const baseSlash = base.endsWith('/') ? base : base + '/';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${baseSlash}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.loli.net" crossorigin />
    <link rel="preconnect" href="https://gstatic.loli.net" crossorigin />
    <link rel="stylesheet" href="https://fonts.loli.net/css2?family=Bricolage+Grotesque:opsz,wght@12..96,800&family=Geist:wght@400;600&family=Geist+Mono&family=Noto+Sans+SC:wght@400;900&display=swap" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body id="top">
    <slot />
  </body>
</html>
